# Copy this file to backend/.env (the FastAPI process loads dotenv from the backend cwd):
#   cp .env.example backend/.env
#
# Never commit backend/.env. Real keys stay local.

# --- Hugging Face (required for gated models: Llama, some Qwen, CodeLlama) ---
# Create at https://huggingface.co/settings/tokens
# Also accept each model's license on the Hub page or downloads will 401/403.
HF_TOKEN=

# --- Google Custom Search (optional; live web search in chat/agent) ---
# Without these, the search controller still runs but google_search() returns [].
# API key: https://console.cloud.google.com/apis/credentials
# CSE ID:  https://programmablesearchengine.google.com/
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Present in some local setups, unused by current backend code ---
# Left here so a copied .env matches older machines. Safe to omit.
GROQ_API_KEY=
CLOUD_API_KEY=

# --- Runtime (optional; start-app.sh already exports these) ---
# HF_HOME is forced to backend/models in app/core/models.py so weights stay in-repo.
# PYTORCH_ENABLE_MPS_FALLBACK=1
# PYTORCH_ALLOC_CONF=expandable_segments:True
